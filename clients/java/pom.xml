  <artifactId>camunda-client-java</artifactId>
  <packaging>jar</packaging>

  <name>Camunda Client Java</name>

  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>http://www.apache.org/licenses/LICENSE-2.0</url>
    </license>
